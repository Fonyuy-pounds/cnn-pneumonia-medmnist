*.egg

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# ============================================
# DATA FILES (Generated by data_prep.py)
# ============================================

# Processed .npy arrays — must NOT be committed
data/*.npy

# Raw dataset downloads (if any)
data/raw/
data/pneumoniamnist/

# ============================================
# MODEL FILES (Generated by train.py)
# ============================================

# Saved Keras/TensorFlow models
models/*.h5
models/*.keras
models/*.hdf5
models/*.weights.h5

# TensorFlow SavedModel directories
models/saved_model/
models/checkpoints/

# ============================================
# PLOTS AND VISUALIZATIONS
# ============================================

# Generated plots — regenerable
plots/*.png
plots/*.jpg
plots/*.pdf
plots/*.svg

# Metrics reports
plots/*.txt

