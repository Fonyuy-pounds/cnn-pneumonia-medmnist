# ============================================
# PYTHON
# ============================================

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Jupyter checkpoints (but NOT notebooks)
.ipynb_checkpoints/

# ============================================
# DATA FILES (generated by data_prep.py)
# ============================================

data/*.npy

# ============================================
# MODEL FILES (generated by train.py)
# ============================================

models/*.h5
models/*.keras
models/*.weights.h5

# ============================================
# PLOTS (generated by train.py and evaluate.py)
# ============================================

plots/*.png
plots/*.jpg
plots/*.pdf
plots/*.txt

# ============================================
# IDE AND EDITOR FILES
# ============================================

.vscode/
.idea/
*.swp
*.swo

# ============================================
# OPERATING SYSTEM FILES
# ============================================

.DS_Store
Thumbs.db
Desktop.ini